{
  "name": "rh.webapp.expression.dhuman.v1",
  "version": "1.0.0",
  "description": "Digital human facial expression control video webapp. Uses a portrait image to generate a video with a selected expression.",
  "resource": {
    "id": "2081607154108289025",
    "type": "webapp"
  },
  "runtime": {
    "defaultInstanceType": "standard",
    "defaultTimeout": 1800,
    "defaultPollInterval": 15
  },
  "inputs": {
