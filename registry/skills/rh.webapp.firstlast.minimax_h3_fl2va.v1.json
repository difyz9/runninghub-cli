{
  "name": "rh.webapp.firstlast.minimax_h3_fl2va.v1",
  "version": "1.0.0",
  "description": "MiniMax H3 FL2VA first-last frame video generation webapp. Uses start/end images with ratio, duration, and prompt.",
  "resource": {
    "id": "2086547118222827522",
    "type": "webapp"
  },
  "runtime": {
